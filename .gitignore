# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/
.Python

# --- Secrets / env ---
.env
.env.local
.env.*.local

# --- Data ---
# Raw source PDFs and processed chunks are large and not committed.
# The empty folders are kept via .gitkeep so the layout is preserved.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# --- Vector store persistence ---
# Build artefact — regenerated by src/embeddings/embedder.py. Never committed.
# Both dev (chroma_db) and prod (chroma_prod) collections plus all diagnostic
# variants live under data/ and are large binary indexes — never git-track.
chroma_db/
data/chroma_db/
data/chroma_db_v1_locked/
data/chroma_db_v2_structure_aware/
data/chroma_db_backup*/
data/chroma_db_repair_test/
data/chroma_prod/
data/chroma_prod_image_test/

# --- Vision cache (regenerated on demand from source PDFs) ---
data/vision_cache/

# --- Chat / session persistence ---
# SQLite DB with user conversations. Contains user-authored content —
# must never be committed. Also excludes SQLite journal/WAL sidecars.
data/agri_rag.db
data/agri_rag.db-journal
data/agri_rag.db-wal
data/agri_rag.db-shm

# --- Eval results (regenerated by run_eval.py) ---
eval/results/*
!eval/results/.gitkeep

# --- Eval / golden-set backups (timestamped, machine-local) ---
eval/*.bak-*
eval/*.bak
eval/golden_set.json.bak-*

# --- Notebooks scratch ---
.ipynb_checkpoints/

# --- Logs (runtime + evaluation, machine-local) ---
logs/

# --- Local smoke-test outputs (scratch files from one-off runs) ---
*_smoke_output.txt
smoke_*.txt
smoke_*.log
smoke_*.json

# --- Diagnostic output files from scripts/ ---
scripts/*_output.txt
scripts/*_output.log
scripts/*_output.json

# --- Root-level scratch / diagnostic scripts from the ingestion incident ---
# These were one-off diagnostics saved next to the code during
# investigation. Kept on disk for reference; not part of the public repo.
/inspect_*.py
/repair_*.py
/repair_*_test.py
/targeted_*.py
/test_repaired_chroma.py
/test_targeted_upsert.py
/verify_new_chunks.py
/qwen_smoke_output.txt
/judge_smoke_output.txt

# --- Claude Code local state ---
# Machine-local Claude Code settings, task locks, and scheduled-run
# state. Never share these — they contain personal permission
# overrides and per-machine bookkeeping.
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/todos/
.claude/history/
.claude/*.lock

# --- IDE / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
# Private AI/development tooling
CLAUDE.md
DECISIONS.md
.claude/

# Local development artifacts
scripts/_keepawake.log
scripts/_keepawake.ps1
scripts/build_prod_collection_dryrun.txt

# One-off diagnostics
scripts/heading_ab_step*
scripts/table_ab_step*
scripts/image_dedup_diagnostic.py
scripts/image_modality_diagnostic*
scripts/image_vision_benchmark.py
scripts/spotcheck_kcc_p15.py
scripts/diag_query4_raw.py
scripts/diff_empty_vs_zero_chunk.py
scripts/inspect_*.py

# No longer used deployment config
fly.toml