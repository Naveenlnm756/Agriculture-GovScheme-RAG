# Copy this file to `.env` and fill in the real values.
# `.env` is gitignored — never commit real keys.

# --- Groq API keys (evaluation-only rotation) ------------------------
# Comma-separated Groq API keys for evaluation.
# Keys are used sequentially only; never in parallel.
# One key works normally.
GROQ_API_KEYS=

# --- Groq API key (production/application generator) -----------------
# Legacy single-key configuration used by the production generator
# path (src/generation/generator.py). Eval falls back to this when
# GROQ_API_KEYS is unset. Set only if you don't already have entries
# in GROQ_API_KEYS above — the first key there is used by production
# automatically if this is empty.
GROQ_API_KEY=

# --- Key-rotation tuning ---------------------------------------------
# Seconds to sleep when every configured Groq key has been rotated away
# from in a single cycle. Default 60 — matches Groq's per-minute TPM
# reset window. Only raise this if you're hitting a DAILY/monthly
# quota (not the per-minute TPM cap).
# KEY_ROTATION_COOLDOWN_S=60

# --- Deterministic-rotation test hook --------------------------------
# When set to an integer N, the eval rotator treats the (N+1)-th call
# to the active key as a simulated rate-limit condition (rotates
# instead of hitting the network). Leave unset in production and for
# the locked ablation table. Used only by scripts/smoke_test_b_*.py.
# SIMULATE_QUOTA_EXHAUSTION_AFTER_N_CALLS=3

# --- Optional overrides (defaults live in src/config.py) --------------
# LLM_PROVIDER=groq
# LLM_MODEL=qwen/qwen3.6-27b            # current locked generator
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Judge model API keys (used by RAGAS during evaluation) ----------
# The RAGAS judge is independent from the generation model
# Current locked judge is Mistral Small v26.03
# (`mistral-small-2603`) via Mistral's own API.
#
# MISTRAL_API_KEYS: comma-separated pool used by RotatingChatMistralAI.
# Keys are rotated sequentially on 429/401. When every key in a cycle
# has been burned, the eval HALTS — there is no cross-provider fallback
# for judge_provider='mistral'  One key works
# normally; MISTRAL_API_KEY below is the legacy single-key fallback if
# MISTRAL_API_KEYS is unset.
MISTRAL_API_KEYS=

# GEMINI_API_KEY is kept wired for other judge_provider values (e.g.
# 'gemini') but is NOT consulted when judge_provider='mistral'.
GEMINI_API_KEY=
# Flip these to toggle techniques on/off without touching code.
# The baseline run has all of them = false.
USE_HYBRID=false
USE_RERANKER=false
USE_QUERY_TRANSFORM=false
USE_CRAG=false

# --- Production / deployment overrides ------------------------------
# All optional locally — the FastAPI backend falls back to the project-
# root defaults (data/chroma_prod + agri_schemes_prod + data/agri_rag.db)
# when these are unset. On Fly.io they MUST be set so the app reads and
# writes on the mounted /data volume, not on ephemeral container disk.
#
# CHROMA_PERSIST_DIR       Path to the persisted Chroma index directory.
#                          Local default:  data/chroma_prod
#                          Fly.io default: /data/chroma_prod
# CHROMA_COLLECTION_NAME   Chroma collection to read from.
#                          Both environments: agri_schemes_prod
# AGRI_DB_PATH             SQLite file for chat/conversation persistence.
#                          Local default:  data/agri_rag.db
#                          Fly.io default: /data/agri_rag.db
# AGRI_API_URL             Where the Streamlit frontend finds the FastAPI
#                          backend. Both processes run in the same
#                          container, so loopback works everywhere.
#                          Both environments: http://127.0.0.1:8000

# CHROMA_PERSIST_DIR=/data/chroma_prod
# CHROMA_COLLECTION_NAME=agri_schemes_prod
# AGRI_DB_PATH=/data/agri_rag.db
# AGRI_API_URL=http://127.0.0.1:8000
